{% set rfc2136_vars_set = (
        rfc2136_zone | default('') and 
        rfc2136_tsig_secret_value | default('') and 
        rfc2136_tsig_secret_alg | default('') and
        rfc2136_tsig_secret_keyname | default('')
    ) 
%}
{% set eab_required = (
        cert_manager_eab_keyid != "" and 
        cert_manager_eab_secret != ""
    )
%}
apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
    name: "{{ cert_manager_cluster_issuer_name }}"
spec:
    acme:
        email: "{{ cert_manager_email }}"
        server: "{{ cert_manager_url }}"

{% if eab_required %}    
        externalAccountBinding:
            keyID: "{{ cert_manager_eab_keyid }}"
            keySecretRef:
                name: "{{ cert_manager_eab_secret_name }}"
                key: secret
{% endif %}

        privateKeySecretRef:
            name: "{{ cert_manager_private_key_secret_name }}"

        solvers:
{% if rfc2136_vars_set and cert_manager_preferred_challenge == 'dns01' %}
            - dns01:
                rfc2136:
                    nameserver: "{{ ('[' + rfc2136_dns_host + ']') if ':' in rfc2136_dns_host else rfc2136_dns_host }}:{{ rfc2136_dns_port }}"
                    tsigKeyName: "{{ rfc2136_tsig_secret_keyname }}"
                    tsigAlgorithm: "{{ rfc2136_tsig_secret_alg | replace('-', '') | upper }}"
                    tsigSecretSecretRef:
                        name: "{{ cert_manager_rfc2136_tsig_secret_name }}" # k8s Secret with the TSIG key, created in 06_addons_cert_manager.yml
                        key: secret
{% for z in rfc2136_additional_zones | default([]) if z.state | default('present') == 'present' %}
            # Further zone {{ z.zone }}: its own TSIG key. dnsZones makes
            # cert-manager prefer this solver for names in that zone over the
            # selector-less one above.
            - selector:
                dnsZones:
                    - "{{ z.zone }}"
              dns01:
                rfc2136:
                    nameserver: "{{ ('[' + rfc2136_dns_host + ']') if ':' in rfc2136_dns_host else rfc2136_dns_host }}:{{ rfc2136_dns_port }}"
                    tsigKeyName: "{{ z.tsig_secret_keyname }}"
                    tsigAlgorithm: "{{ (z.tsig_secret_alg | default(rfc2136_tsig_secret_alg)) | replace('-', '') | upper }}"
                    tsigSecretSecretRef:
                        name: "{{ cert_manager_rfc2136_tsig_secret_name }}-{{ z.zone | replace('.', '-') }}"
                        key: secret
{% endfor %}
{% else %}
            - http01:
                ingress:
                    class: "traefik"
{% endif %}

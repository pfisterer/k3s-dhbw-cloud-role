# ------------------------------------------------------------------------------
# Namespace is usually created outside Helm, but you can note it here
# ------------------------------------------------------------------------------
namespace: "{{ external_dns_namespace}}"

# ------------------------------------------------------------------------------
# Image configuration
# ------------------------------------------------------------------------------
image:
  repository: registry.k8s.io/external-dns/external-dns
  tag: "{{ external_dns_version }}"
  pullPolicy: Always

# ------------------------------------------------------------------------------
# Provider (Helm-native)
# ------------------------------------------------------------------------------
logLevel: "{{ external_dns_log_level }}"

# Each reconciliation is a full AXFR of the zone; --events keeps record creation
# fast so the interval can stay well above the chart default of 1m.
interval: "{{ external_dns_interval }}"
triggerLoopOnEvent: {{ external_dns_trigger_loop_on_event | bool | ternary('true', 'false') }}

provider:
  name: rfc2136

# Set via the chart's own key, NOT via extraArgs: the chart always renders
# --source from this list, so passing --source in extraArgs only appends and the
# chart default (service, ingress) stays active. That silently enabled
# --source=service and passed --source=ingress twice. Driving it from here also
# makes the chart generate the Traefik CRD RBAC itself.
sources:
  - ingress
  - traefik-proxy

policy: sync

registry: txt
txtOwnerId: "{{ external_dns_txt_owner_id }}"
txtPrefix: "{{ external_dns_txt_prefix }}"

# ------------------------------------------------------------------------------
# CLI arguments corresponding to your deployment spec
# ------------------------------------------------------------------------------
extraArgs:
  - --managed-record-types=A
  - --managed-record-types=AAAA
  - --managed-record-types=CNAME
  - --domain-filter={{ rfc2136_zone }}
{% for net in external_dns_exclude_target_nets %}
  - --exclude-target-net={{ net }}
{% endfor %}
  - --rfc2136-host={{ rfc2136_dns_host }}
  - --rfc2136-port={{ rfc2136_dns_port }}
  - --rfc2136-zone={{ rfc2136_zone }}
  - --rfc2136-tsig-secret={{ rfc2136_tsig_secret_value }}
  - --rfc2136-tsig-secret-alg={{ rfc2136_tsig_secret_alg }}
  - --rfc2136-tsig-keyname={{ rfc2136_tsig_secret_keyname }}
  - --rfc2136-tsig-axfr

# ------------------------------------------------------------------------------
# RBAC — extra permissions for Traefik CRDs (required by --source=traefik-proxy).
# The chart already derives these from `sources` above, so this block is now a
# duplicate. Kept deliberately: if a chart version ever stops generating them the
# traefik-proxy source fails silently (IngressRoutes simply stop being picked up),
# and an extra ClusterRole rule costs nothing.
# ------------------------------------------------------------------------------
rbac:
  additionalPermissions:
    - apiGroups:
        - traefik.io
      resources:
        - ingressroutes
        - ingressroutetcps
        - ingressrouteudps
      verbs:
        - get
        - list
        - watch
